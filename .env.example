# ============================================================================
# Static-fee book — deploy & agent env (Robinhood Chain; ETH gas)
# Copy to `.env` (never commit secrets). Chain records: deployments/robinhood-*.json
# ============================================================================

# --- Deployer (Foundry scripts) ---
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# --- Robinhood Chain RPC ---
# Public RPC sits behind a Cloudflare challenge; scripts add browser-like headers.
# For foundry forks use the proxy: `npm run robinhood:proxy` then ROBINHOOD_RPC_URL=http://127.0.0.1:8546
# (or point this at a provider RPC, e.g. Alchemy/Chainstack/QuickNode).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Canonical v4 + shared infra (chain 4663) ---
# Full record (PoolManager/PositionManager/Quoter/StateView/UniversalRouter): deployments/robinhood-mainnet.json
V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
ROBINHOOD_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# --- Book assets (verified on-chain; re-run `npm run robinhood:verify`) ---
# Quote: USDG (6 dec) for the USDG book, WETH (18 dec) for the WETH/NVDA book.
# Equity: NVDA stock token (ERC-20 18-dec + ERC-8056 uiMultiplier)
QUOTE_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# WETH quote for the WETH/NVDA book: 0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
NVDA_ADDRESS=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
# Chainlink stock feed (price already includes the corporate-action multiplier)
ROBINHOOD_NVDA_CHAINLINK_FEED=0x379EC4f7C378F34a1B47E4F3cbeBCbAC3E8E9F15
# Keeper session/status writer exposing marketStatus() (deployed oracle or pusher)
ROBINHOOD_SESSION_SOURCE=
# Deployed ChainlinkSessionOracle (hook price oracle)
NVDA_ORACLE=

# --- Oracle deployment (script/DeployOracle.s.sol) ---
ORACLE_OWNER=
ORACLE_WRITER=
ORACLE_MAX_STALENESS=300

# --- In-repo Aave semi-fork (testnet venue / lending adapter) ---
NVDA_PEGGED_PRICE=20000000000
USDC_PEGGED_PRICE=100000000
LENDING_BASE_BORROW_RATE=0
LENDING_RATE_SLOPE1=40000000000000000000000000
LENDING_RATE_SLOPE2=600000000000000000000000000
LENDING_OPTIMAL_UTILIZATION=800000000000000000000000000
LENDING_LTV=7500
LENDING_LIQUIDATION_THRESHOLD=8000
LENDING_LIQUIDATION_BONUS=10500
LENDING_RESERVE_FACTOR=1000

# --- Static book init config (script/DeployStaticStack.s.sol) ---
STATIC_FEE=3000
STATIC_TICK_SPACING=60
STATIC_INITIAL_TICK=
STATIC_GUARD_TICK_WIDTH=600
STATIC_BASE_TICK_WIDTH=6000
STATIC_GUARD_LIQUIDITY=50000000000000
STATIC_BASE_LIQUIDITY=500000000000
STATIC_MIN_EV_BPS=0
STATIC_RECHECK_MAX_DEV_BPS=50
STATIC_RECHECK_INTERVAL=300
STATIC_MAX_PRICE_AGE=300
STATIC_ALLOWED_SESSIONS_MASK=0
STATIC_EXPIRY=0
STATIC_INIT_BOOK=false
STATIC_VAULT=
STATIC_SIMULATOR=
# Wind-down: agent soft-halts (deployments off) this many seconds before expiry
STATIC_WINDDOWN_LEAD_SECONDS=3600

# --- Depeg latch: stock reference vs deep-pool TWAP ---
# Deepest on-chain USDG/NVDA venue (Robinhood Chain MAINNET: Uniswap v3 0.05%
# 0xd4EB21209C4D6093f80B5b84f5C45cc093EA14a3). Leave empty to disable the price
# latch (Chainlink-only fallback) or to use a different testnet pool.
DEEP_POOL=
# Minimum in-range pool liquidity (native L units) to trust the TWAP. 0.05% pool ~1.8e18.
DEEP_MIN_LIQUIDITY=500000000000000000
# Latch threshold (bps) between the Chainlink stock mid and the deep-pool TWAP.
DEPEG_THRESHOLD_BPS=200
# TWAP window (seconds) and how long the divergence must persist before latching.
DEPEG_TWAP_WINDOW=1800
DEPEG_MIN_DURATION=600
# Heartbeat cadence (seconds): market open vs closed.
DEPEG_INTERVAL_OPEN=1800
DEPEG_INTERVAL_CLOSED=3600
# Re-arm freshness gate: keeper re-enable/deploy/rearm requires a check this recent.
# 0 disables the gate.
DEPEG_MAX_CHECK_AGE=5400

# --- Dual-book stack (script/DeployDualBookStack.s.sol): low-fee book A + high-fee B ---
STATIC_FEE_A=3000
STATIC_TICK_SPACING_A=60
STATIC_FEE_B=10000
STATIC_TICK_SPACING_B=200
# Per-book guard params for B (A reuses the STATIC_* above); same keys, STATIC_B_ prefix
STATIC_B_GUARD_TICK_WIDTH=600
STATIC_B_BASE_TICK_WIDTH=6000
STATIC_B_GUARD_LIQUIDITY=50000000000000
STATIC_B_BASE_LIQUIDITY=500000000000
STATIC_B_MIN_EV_BPS=0
STATIC_B_RECHECK_MAX_DEV_BPS=50
STATIC_B_RECHECK_INTERVAL=300
STATIC_B_MAX_PRICE_AGE=300
STATIC_B_ALLOWED_SESSIONS_MASK=0
# Init both books armed (needs inventory: init deploys bands strictly). Approve the
# deploy script for quote+equity first. A funds via the vault, B stages direct.
STATIC_INIT_BOOKS=false
STATIC_FUND_QUOTE=
STATIC_FUND_EQUITY=
STATIC_FUND_B_QUOTE=
STATIC_FUND_B_EQUITY=

# --- Strategy module (Morpho on Robinhood) ---
# Primary NVDA/USDG market (lltv 62.5%) verified on-chain; deepest market (0x8b16…9c3e) is ~100%
# utilized — do not park there. RH Morpho has no id() view; ids = keccak256(abi.encode(params)).
ROBINHOOD_MORPHO_BLUE=0x9D53d5E3bd5E8d4Cbfa6DB1ca238AEA02E651010
MORPHO_MARKET_ORACLE=0x37CF511fA79B8446f1C23D6a81Df117F28240bE0
MORPHO_MARKET_IRM=0x2BD3d5965B26B51814AC95127B2b80dD6CcC0fa1
MORPHO_MARKET_LLTV=625000000000000000
STATIC_ALLOCATOR_ADDRESS=
STATIC_SENTINEL_ADDRESS=
STATIC_STRATEGY_TIMELOCK_SECONDS=86400

# --- Agent (operator key = allocator/keeper; see agent/README.md) ---
AGENT_OPERATOR_PRIVATE_KEY=
AGENT_OPERATOR_ADDRESS=

# --- Spiral NVDA strategy arm (script/DeploySpiralArm.s.sol) ---
# Spiral's NVDA product posts NVDA to NetNet's Morpho market and borrows USDG; the repo's
# MorphoLoopAdapter is that arm. NetNet NVDA market params (verified on 4663):
SPIRAL_NVDA_ORACLE=0xED29D310cfa91778A5850538DA28ed42234Cb78c
SPIRAL_NVDA_IRM=0x2BD3d5965B26B51814AC95127B2b80dD6CcC0fa1
SPIRAL_NVDA_LLTV=625000000000000000
# Target stock LTV as bps of the market LLTV (4700 = 29.375% LTV on a 62.5% market).
# Hard rule: keep stock LTV below 30%.
SPIRAL_NVDA_TARGET_LTV_OF_LLTV_BPS=4700
SPIRAL_NVDA_MIN_HEALTH_FACTOR=1500000000000000000
# Arm caps: absolute (USDG base units) and relative to NAV.
SPIRAL_ARM_ABS_CAP=10000000000
SPIRAL_ARM_REL_CAP_BPS=2000
SPIRAL_ARM_CONFIGURE=true
# Set true only on the second run, after the module timelock (default 24h) has elapsed.
SPIRAL_ARM_EXECUTE=false

# --- Deploy idle NVDA into the arm (script/AllocateSpiralArm.s.sol) ---
# The arm's input is NVDA (collateral). Borrow is optional and sends USDG to the vault.
STRATEGY_AGENT_ADDRESS=
SPIRAL_ARM_ADAPTER=
SPIRAL_ARM_NVDA_AMOUNT=
SPIRAL_ARM_BORROW_AMOUNT=0

# --- Self-run keeper (Yearn-style; scripts/keeper) ---
# Long-running process, not GitHub Actions. Dry-run by default.
KEEPER_RPC_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_CHAIN_ID=4663
# Operator key: must be the vault depegKeeper, the main keeper, or the sleeve keeper
# depending on which action it executes.
KEEPER_PRIVATE_KEY=
KEEPER_DRY_RUN=true
KEEPER_INTERVAL_SECONDS=300
KEEPER_HEARTBEAT_SECONDS=1800
KEEPER_RECHECK_SECONDS=300
# Core addresses.
KEEPER_VAULT=
KEEPER_HEARTBEAT=
KEEPER_HOOK=
# Quote and equity tokens (fallback to QUOTE_ADDRESS / NVDA_ADDRESS if empty).
KEEPER_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
KEEPER_NVDA=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
# Optional sleeve; leave empty to skip sleeve checks.
KEEPER_SLEEVE=
# Spiral NVDA arm (a MorphoLoopAdapter on the NetNet NVDA market); leave empty to skip.
KEEPER_ARM_ADAPTER=
# VaultStrategyAgent address (operator relays de-leverage through it).
KEEPER_AGENT=
KEEPER_MIN_HEALTH_FACTOR=1500000000000000000
KEEPER_MAX_BORROW_APR_BPS=3000
# De-leverage fraction per tick (bps of outstanding debt).
KEEPER_DELEVERAGE_BPS=1000
# Sleeve policy thresholds (bps).
KEEPER_MAX_STOCK_LTV_BPS=3000
KEEPER_MAX_YIELD_LTV_BPS=8500
KEEPER_MIN_HEALTH_BPS=2500
KEEPER_MIN_CARRY_BPS=300

# --- Risk-based allocator (fee / volume / volatility over the lookback) ---
# No APR target and no min-carry rule. Arms are the safe harbor; the book earns fees.
KEEPER_ALLOCATOR_ENABLED=true
KEEPER_ALLOCATOR_INTERVAL_SECONDS=3600
KEEPER_ALLOCATOR_EXECUTE=false
# Fallback only; used when KEEPER_BLOCK_TIME_SECONDS=0.
KEEPER_STATS_LOOKBACK_SECONDS=21600
# Actual stats window = blocks × block time. Robinhood is ~0.1s/block:
# 21600 ≈ 36m, 36000 ≈ 1h, 216000 ≈ 6h.
KEEPER_STATS_LOOKBACK_BLOCKS=21600
KEEPER_BLOCK_TIME_SECONDS=0.1
KEEPER_POOL_MANAGER=
KEEPER_BOOK_A_POOL_ID=
KEEPER_BOOK_B_POOL_ID=
# Uniswap fee units: pips per 1e6 (500 = 0.05%, 3000 = 0.30%, 10000 = 1.00%).
KEEPER_BOOK_A_FEE_PIPS=500
KEEPER_BOOK_B_FEE_PIPS=3000
# Risk thresholds. Fee floor 0 = disabled (no APR target).
KEEPER_RISK_MAX_VOLATILITY_BPS=300
KEEPER_RISK_MIN_VOLUME_USD=10000
KEEPER_RISK_MIN_FEE_APR_BPS=0
# Part-by-part move sizes (bps per tick): most quote first, NVDA in small slices.
KEEPER_MORPHO_ARM_SHARE_BPS=8000
KEEPER_NVDA_STEP_BPS=1000
KEEPER_BOOK_STEP_BPS=2500
# Unwind: snap to 100% when the next slice is below these amounts.
KEEPER_UNWIND_DUST_USDG=1000000
KEEPER_UNWIND_DUST_NVDA=1000000000000000
# Extra USDG approved for a repay; the module refunds the unused quote.
KEEPER_REPAY_BUFFER_USDG=1000000
# Fraction of idle vault assets sent to the book after the arms unwind.
KEEPER_FUND_BOOK_BPS=9000
# Cross-book switch: best candidate must beat net APR after IL by this buffer (bps).
KEEPER_SWITCH_BUFFER_BPS=500
# Candidate pools scanned every allocator tick. Empty = use BOOK_A_POOL/BOOK_B_POOL.
# Example:
# KEEPER_CANDIDATE_POOLS=[{"name":"bookA","kind":"v4","poolId":"0x...","feePips":500,"book":0,"switchable":true},{"name":"bookB","kind":"v4","poolId":"0x...","feePips":3000,"book":1,"switchable":true}]
KEEPER_CANDIDATE_POOLS=
# Fallback IL half-width for the inactive book (bps): 1000 = +-10%.
# The active book uses its actual basePosition tick range.
KEEPER_RANGE_HALF_WIDTH_BPS=1000
# Ignore books whose active-liquidity value is below this (USD).
KEEPER_MIN_POOL_LIQUIDITY_USD=10000
# Optional wait after a recent guard pull (seconds). 0 disables it.
# A recent pull waits/re-arms the book; it is not an arm trigger.
KEEPER_GUARD_COOLDOWN_SECONDS=0
# More than this many GuardPulled events since the previous allocator run -> safe harbor.
# 1-2 pulls wait/re-arm; the third arms. Count resets every allocator run.
KEEPER_MAX_GUARD_PULLS=2
# USDG Morpho lending arm (MorphoBlueLendAdapter). Leave empty until deployed.
KEEPER_USDG_ADAPTER=
# --- Deploy the USDG lend arm (script/DeployUsdgLendArm.s.sol) ---
# Example: syrupUSDG/USDG market: collateral 0x4085..., oracle 0x152c..., LLTV 0.915.
USDG_LEND_COLLATERAL=
USDG_LEND_ORACLE=
USDG_LEND_IRM=0x2BD3d5965B26B51814AC95127B2b80dD6CcC0fa1
USDG_LEND_LLTV=
USDG_LEND_ABS_CAP=
USDG_LEND_REL_CAP_BPS=2000
USDG_LEND_EXECUTE=false
# Optional Slack/Telegram-compatible webhook.
KEEPER_WEBHOOK_URL=

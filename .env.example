# ============================================================================
# Static-fee book — generic deployment template (Robinhood Chain; ETH gas)
# Copy to `.env` (never commit secrets). Chain records: deployments/robinhood-*.json
#
# This file is a TEMPLATE, not a preset. No market oracle, LLTV, pool id, cap or
# price is filled in; those are chosen per deployment and checked with:
#   npm run keeper:preflight
# `scripts/keeper/config.mjs` is the source of truth for key names, defaults and ranges.
# ============================================================================

# --- Deployer (Foundry scripts) ---
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# --- Robinhood Chain RPC ---
# Public RPC sits behind a Cloudflare challenge; scripts add browser-like headers.
# For foundry forks use the proxy: `npm run robinhood:proxy` then ROBINHOOD_RPC_URL=http://127.0.0.1:8546
# (or point this at a provider RPC, e.g. Alchemy/Chainstack/QuickNode).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Canonical v4 + shared infra (chain 4663) ---
# chain 4663 constant — re-verify at deployment
# Full record (PoolManager/PositionManager/Quoter/StateView/UniversalRouter): deployments/robinhood-mainnet.json
V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
# chain 4663 constant — re-verify at deployment
ROBINHOOD_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# --- Book assets (chain 4663) ---
# chain 4663 constant — re-verify at deployment
# Quote: USDG (6 dec) for the USDG book, WETH (18 dec) for the WETH/NVDA book.
QUOTE_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# chain 4663 constant — re-verify at deployment
# Equity: NVDA stock token (ERC-20 18-dec + ERC-8056 uiMultiplier)
NVDA_ADDRESS=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
# chain 4663 constant — re-verify at deployment
# WETH quote for `nvda-eth` reference pools (fallback; KEEPER_WETH takes precedence).
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Chainlink stock feed (price already includes the corporate-action multiplier)
ROBINHOOD_NVDA_CHAINLINK_FEED=0x379EC4f7C378F34a1B47E4F3cbeBCbAC3E8E9F15
# Keeper session/status writer exposing marketStatus() (deployed oracle or pusher)
ROBINHOOD_SESSION_SOURCE=
# Deployed ChainlinkSessionOracle (hook price oracle)
NVDA_ORACLE=

# --- Oracle deployment (script/DeployOracle.s.sol) ---
ORACLE_OWNER=
ORACLE_WRITER=
ORACLE_MAX_STALENESS=300

# --- In-repo Aave semi-fork (testnet venue / lending adapter) ---
NVDA_PEGGED_PRICE=20000000000
USDC_PEGGED_PRICE=100000000
LENDING_BASE_BORROW_RATE=0
LENDING_RATE_SLOPE1=40000000000000000000000000
LENDING_RATE_SLOPE2=600000000000000000000000000
LENDING_OPTIMAL_UTILIZATION=800000000000000000000000000
LENDING_LTV=7500
LENDING_LIQUIDATION_THRESHOLD=8000
LENDING_LIQUIDATION_BONUS=10500
LENDING_RESERVE_FACTOR=1000

# --- Static book init config (script/DeployStaticStack.s.sol) ---
STATIC_FEE=3000
STATIC_TICK_SPACING=60
STATIC_INITIAL_TICK=
STATIC_GUARD_TICK_WIDTH=600
STATIC_BASE_TICK_WIDTH=6000
STATIC_GUARD_LIQUIDITY=50000000000000
STATIC_BASE_LIQUIDITY=500000000000
STATIC_MIN_EV_BPS=0
STATIC_RECHECK_MAX_DEV_BPS=50
STATIC_RECHECK_INTERVAL=300
STATIC_MAX_PRICE_AGE=300
STATIC_ALLOWED_SESSIONS_MASK=0
STATIC_EXPIRY=0
STATIC_INIT_BOOK=false
STATIC_VAULT=
STATIC_SIMULATOR=
# Wind-down: agent soft-halts (deployments off) this many seconds before expiry
STATIC_WINDDOWN_LEAD_SECONDS=3600

# --- Depeg latch: stock reference vs deep-pool TWAP ---
# Deepest on-chain USDG/NVDA venue (Robinhood Chain MAINNET: Uniswap v3 0.05%
# 0xd4EB21209C4D6093f80B5b84f5C45cc093EA14a3). Leave empty to disable the price
# latch (Chainlink-only fallback) or to use a different testnet pool.
DEEP_POOL=
# Minimum in-range pool liquidity (native L units) to trust the TWAP. 0.05% pool ~1.8e18.
DEEP_MIN_LIQUIDITY=500000000000000000
# Latch threshold (bps) between the Chainlink stock mid and the deep-pool TWAP.
DEPEG_THRESHOLD_BPS=200
# TWAP window (seconds) and how long the divergence must persist before latching.
DEPEG_TWAP_WINDOW=1800
DEPEG_MIN_DURATION=600
# Heartbeat cadence (seconds): market open vs closed.
DEPEG_INTERVAL_OPEN=1800
DEPEG_INTERVAL_CLOSED=3600
# Re-arm freshness gate: keeper re-enable/deploy/rearm requires a check this recent.
# 0 disables the gate.
DEPEG_MAX_CHECK_AGE=5400

# --- Dual-book stack (script/DeployDualBookStack.s.sol): low-fee book A + high-fee B ---
STATIC_FEE_A=3000
STATIC_TICK_SPACING_A=60
STATIC_FEE_B=10000
STATIC_TICK_SPACING_B=200
# Per-book guard params for B (A reuses the STATIC_* above); same keys, STATIC_B_ prefix
STATIC_B_GUARD_TICK_WIDTH=600
STATIC_B_BASE_TICK_WIDTH=6000
STATIC_B_GUARD_LIQUIDITY=50000000000000
STATIC_B_BASE_LIQUIDITY=500000000000
STATIC_B_MIN_EV_BPS=0
STATIC_B_RECHECK_MAX_DEV_BPS=50
STATIC_B_RECHECK_INTERVAL=300
STATIC_B_MAX_PRICE_AGE=300
STATIC_B_ALLOWED_SESSIONS_MASK=0
# Init both books armed (needs inventory: init deploys bands strictly). Approve the
# deploy script for quote+equity first. A funds via the vault, B stages direct.
STATIC_INIT_BOOKS=false
STATIC_FUND_QUOTE=
STATIC_FUND_EQUITY=
STATIC_FUND_B_QUOTE=
STATIC_FUND_B_EQUITY=

# --- Strategy module (Morpho on Robinhood) ---
# No market params are baked in: the vault's Morpho market (oracle/IRM/LLTV) is chosen at
# deployment. RH Morpho has no id() view; ids = keccak256(abi.encode(params)).
# chain 4663 constant — re-verify at deployment
ROBINHOOD_MORPHO_BLUE=0x9D53d5E3bd5E8d4Cbfa6DB1ca238AEA02E651010
STATIC_ALLOCATOR_ADDRESS=
STATIC_SENTINEL_ADDRESS=
STATIC_STRATEGY_TIMELOCK_SECONDS=86400

# --- Agent (operator key = allocator/keeper; see agent/README.md) ---
AGENT_OPERATOR_PRIVATE_KEY=
AGENT_OPERATOR_ADDRESS=

# --- Spiral NVDA strategy arm (script/DeploySpiralArm.s.sol) ---
# Spiral's NVDA product posts NVDA to NetNet's Morpho market and borrows USDG; the repo's
# MorphoLoopAdapter is that arm. Market params differ per deployment, so they stay blank.
# set at deployment; verify with npm run keeper:preflight
SPIRAL_NVDA_ORACLE=
# set at deployment; verify with npm run keeper:preflight
SPIRAL_NVDA_IRM=
# set at deployment; verify with npm run keeper:preflight
SPIRAL_NVDA_LLTV=
# Target stock LTV as bps of the market LLTV (4700 = 29.375% LTV on a 62.5% market).
# Hard rule: keep stock LTV below 30%.
SPIRAL_NVDA_TARGET_LTV_OF_LLTV_BPS=4700
SPIRAL_NVDA_MIN_HEALTH_FACTOR=1500000000000000000
# Arm caps: relative to NAV. The absolute cap depends on the market's scale.
# set at deployment; verify with npm run keeper:preflight
SPIRAL_ARM_ABS_CAP=
SPIRAL_ARM_REL_CAP_BPS=2000
SPIRAL_ARM_CONFIGURE=true
# Set true only on the second run, after the module timelock (default 24h) has elapsed.
SPIRAL_ARM_EXECUTE=false

# --- Deploy idle NVDA into the arm (script/AllocateSpiralArm.s.sol) ---
# The arm's input is NVDA (collateral). Borrow is optional and sends USDG to the vault.
STRATEGY_AGENT_ADDRESS=
# set at deployment; verify with npm run keeper:preflight
SPIRAL_ARM_ADAPTER=
SPIRAL_ARM_NVDA_AMOUNT=
SPIRAL_ARM_BORROW_AMOUNT=0

# --- Self-run keeper (Yearn-style; scripts/keeper) ---
# Long-running process, not GitHub Actions. Dry-run by default.
# `scripts/keeper/config.mjs` validates these; preflight is the deployment gate.
KEEPER_RPC_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_CHAIN_ID=4663
KEEPER_RPC_TIMEOUT_MS=30000
KEEPER_RPC_RETRIES=2
# Operator key: must be the vault depegKeeper, the main keeper, or the sleeve keeper
# depending on which action it executes.
KEEPER_PRIVATE_KEY=
KEEPER_DRY_RUN=true
# Main loop cadence, heartbeat cadence, and per-check recheck (seconds).
KEEPER_INTERVAL_SECONDS=300
KEEPER_HEARTBEAT_SECONDS=1800
KEEPER_RECHECK_SECONDS=300
# Optional state file for cross-run bookkeeping (empty = in-memory only).
KEEPER_STATE_FILE=
# Require every address / pool id up front (implied by KEEPER_ALLOCATOR_EXECUTE=true).
KEEPER_STRICT_CONFIG=false
# Optional Slack/Telegram-compatible webhook for alerts.
KEEPER_WEBHOOK_URL=

# Core addresses.
KEEPER_VAULT=
KEEPER_HEARTBEAT=
KEEPER_HOOK=
# Optional sleeve; leave empty to skip sleeve checks.
KEEPER_SLEEVE=
# VaultStrategyAgent address (operator relays de-leverage through it).
KEEPER_AGENT=
# chain 4663 constant — re-verify at deployment
KEEPER_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
# Quote and equity tokens. Empty = fall back to QUOTE_ADDRESS / NVDA_ADDRESS above.
# set at deployment; verify with npm run keeper:preflight
KEEPER_USDG=
# set at deployment; verify with npm run keeper:preflight
KEEPER_NVDA=
# WETH quote token for the NVDA/ETH reference pools. Empty = fall back to WETH_ADDRESS.
# set at deployment; verify with npm run keeper:preflight
KEEPER_WETH=

# --- Risk policy ---
KEEPER_MIN_HEALTH_FACTOR=1500000000000000000
KEEPER_MAX_BORROW_APR_BPS=3000
# De-leverage fraction per tick (bps of outstanding debt).
KEEPER_DELEVERAGE_BPS=1000
# Sleeve policy thresholds (bps).
KEEPER_MAX_STOCK_LTV_BPS=3000
KEEPER_MAX_YIELD_LTV_BPS=8500
KEEPER_MIN_HEALTH_BPS=2500
KEEPER_MIN_CARRY_BPS=300
# ETH/USD used for gas costing: a Chainlink feed wins; otherwise a manual override
# (0 = unset). One of the two is needed for preflight to price gas.
# set at deployment; verify with npm run keeper:preflight
KEEPER_ETH_USD_FEED=
KEEPER_ETH_USD=0

# --- Risk-based allocator (fee / volume / volatility over the lookback) ---
# No APR target and no min-carry rule. Arms are the safe harbor; the book earns fees.
KEEPER_ALLOCATOR_ENABLED=true
# 2h between swings; the book keeps earning fees in between.
KEEPER_ALLOCATOR_INTERVAL_SECONDS=7200
KEEPER_ALLOCATOR_EXECUTE=false
# Fallback only; used when KEEPER_BLOCK_TIME_SECONDS=0.
KEEPER_STATS_LOOKBACK_SECONDS=21600
# Actual stats window = blocks × block time. Robinhood is ~0.1s/block:
# 21600 ≈ 36m, 36000 ≈ 1h, 216000 ≈ 6h.
KEEPER_STATS_LOOKBACK_BLOCKS=21600
KEEPER_BLOCK_TIME_SECONDS=0.1
# Static book pool ids are written after pool initialization.
# set at deployment; verify with npm run keeper:preflight
KEEPER_BOOK_A_POOL_ID=
# set at deployment; verify with npm run keeper:preflight
KEEPER_BOOK_B_POOL_ID=
# Uniswap fee units: pips per 1e6 (500 = 0.05%, 3000 = 0.30%, 10000 = 1.00%).
KEEPER_BOOK_A_FEE_PIPS=500
KEEPER_BOOK_B_FEE_PIPS=3000
# Risk thresholds. 15k notional over the window keeps a thin book from being trusted;
# fee floor 0 = disabled (no APR target).
KEEPER_RISK_MAX_VOLATILITY_BPS=300
KEEPER_RISK_MIN_VOLUME_USD=15000
KEEPER_RISK_MIN_FEE_APR_BPS=0
# Fallback IL half-width for the inactive book (bps): 1000 = +-10%.
# The active book uses its actual basePosition tick range.
KEEPER_RANGE_HALF_WIDTH_BPS=1000
# Ignore books whose active-liquidity value is below this (USD).
KEEPER_MIN_POOL_LIQUIDITY_USD=10000
# Quote held back from the book as an inventory buffer: absolute USD and bps of NAV.
KEEPER_INVENTORY_RESERVE_USD=1000
KEEPER_INVENTORY_RESERVE_PCT_BPS=500
# Cost budget: gas + fees for a move should pay back within this many days.
KEEPER_MAX_PAYBACK_DAYS=30
KEEPER_GAS_UNITS_PER_ACTION=500000
# Fee accrual window used by the APR math (seconds).
KEEPER_FEE_WINDOW_SECONDS=86400
# Candidate pools scanned every allocator tick. Empty = use BOOK_A/BOOK_B pool ids.
# Example:
# KEEPER_CANDIDATE_POOLS=[{"name":"bookA","kind":"v4","poolId":"0x...","feePips":500,"book":0,"switchable":true},{"name":"bookB","kind":"v4","poolId":"0x...","feePips":3000,"book":1,"switchable":true}]
# set at deployment; verify with npm run keeper:preflight
KEEPER_CANDIDATE_POOLS=
# Optional wait after a recent guard pull (seconds). 0 disables it.
# A recent pull waits/re-arms the book; it is not an arm trigger.
KEEPER_GUARD_COOLDOWN_SECONDS=0
# More than this many GuardPulled events since the previous allocator run -> safe harbor.
# 1-2 pulls wait/re-arm; the third arms. Count resets every allocator run.
KEEPER_MAX_GUARD_PULLS=2
# eth_getLogs chunk size; lower it for strict RPC providers.
KEEPER_LOGS_CHUNK_BLOCKS=50000

# --- Reference market (external NVDA/USD + NVDA/ETH pools) and course correction ---
# Read-only market data used to sanity-check the keeper's own bands. `mode` gates the whole
# path: off = never read, advisory = log only, apply = nudge bands (not implemented on-chain
# yet, so it behaves like advisory). Off also keeps an empty pool list valid in strict mode.
KEEPER_COURSE_CORRECT_MODE=off
# Reference notional (USD) and the TWAP windows (seconds); fast window must be <= the window.
KEEPER_REFERENCE_ALLOC_USD=1000
KEEPER_REFERENCE_WINDOW_SECONDS=86400
KEEPER_REFERENCE_FAST_WINDOW_SECONDS=21600
# A pool is unhealthy when its price deviates from the cross-pool mid (PRICE_DEV), when peers
# disagree too much (DISPERSION), when the NVDA/USD and NVDA/ETH mids diverge (CROSS_DEV),
# when its newest swap is older than MAX_STALE_SECONDS, or when it misses the volume/swap
# floors below. Fewer than MIN_HEALTHY healthy pools = no reference mid.
KEEPER_REFERENCE_MAX_PRICE_DEV_BPS=200
KEEPER_REFERENCE_MAX_DISPERSION_BPS=300
KEEPER_REFERENCE_MAX_CROSS_DEV_BPS=300
KEEPER_REFERENCE_MAX_STALE_SECONDS=1800
KEEPER_REFERENCE_MIN_HEALTHY=2
KEEPER_REFERENCE_MIN_VOLUME_USD=50000
KEEPER_REFERENCE_MIN_SWAPS=50
# eth_getLogs chunk size for reference pools; lower it for strict RPC providers.
KEEPER_REFERENCE_LOGS_CHUNK_BLOCKS=50000
# Reference pool registry: ONE line of JSON (schema in scripts/keeper/reference-pools.mjs).
# Empty = the disabled placeholders there, so the reference view stays off. Enabled entries
# require `quoteToken` and `equityToken` (and v3 `address` / v4 `poolId`); v3 takes feePips,
# v4 takes poolManager/tickSpacing. WETH (KEEPER_WETH) is the quote for `nvda-eth`, USDG for
# `nvda-usd`. Placeholders only — fill in this deployment's pools before enabling.
# KEEPER_REFERENCE_POOLS=[{"name":"nvda-usd-v3-005","kind":"v3","pair":"nvda-usd","enabled":true,"address":"0x...","quoteToken":"0x...","equityToken":"0x...","feePips":500},{"name":"nvda-usd-v3-030","kind":"v3","pair":"nvda-usd","enabled":true,"address":"0x...","quoteToken":"0x...","equityToken":"0x...","feePips":3000},{"name":"nvda-eth-v3-005","kind":"v3","pair":"nvda-eth","enabled":true,"address":"0x...","quoteToken":"0x...","equityToken":"0x...","feePips":500},{"name":"nvda-usd-v4-ext","kind":"v4","pair":"nvda-usd","enabled":true,"poolId":"0x...","poolManager":"0x...","tickSpacing":60,"quoteToken":"0x...","equityToken":"0x..."}]
KEEPER_REFERENCE_POOLS=
# Course-correction bands: the reference mid nudges guard width/share and risk sizing, but
# only inside these bounds (each MIN must be <= its MAX). Buffers add slack vs the mid.
KEEPER_COURSE_BUFFER_BPS=500
KEEPER_COURSE_FAST_BUFFER_BPS=1000
KEEPER_COURSE_GUARD_WIDTH_MIN_BPS=200
KEEPER_COURSE_GUARD_WIDTH_MAX_BPS=3000
KEEPER_COURSE_GUARD_SHARE_MIN_BPS=1000
KEEPER_COURSE_GUARD_SHARE_MAX_BPS=9000
KEEPER_COURSE_RISK_VOL_MIN_BPS=150
KEEPER_COURSE_RISK_VOL_MAX_BPS=1200
KEEPER_COURSE_RISK_VOLUME_MIN_USD=5000
KEEPER_COURSE_RISK_VOLUME_MAX_USD=100000
KEEPER_COURSE_BASELINE_VOL_BPS=300
KEEPER_COURSE_BASELINE_VOLUME_USD=15000
KEEPER_COURSE_ARM_VOL_HIGH_BPS=600

# --- Morpho arms (collateral/borrow loop + USDG carry) ---
# set at deployment; verify with npm run keeper:preflight
KEEPER_ARM_ADAPTER=
# Hard cap on stock LTV (3000 = 30%); target must be <= max.
KEEPER_ARM_MAX_LTV_BPS=3000
KEEPER_ARM_TARGET_LTV_BPS=2937
# Collateral -> borrow -> lend loop, and the carry (yield) leg.
KEEPER_ARM_LOOP_ENABLED=true
KEEPER_CARRY_ARM_ENABLED=true
# Minimum borrow-vs-lend spread to open the carry arm, and the level to close it
# (0 = close only when the spread reaches zero).
KEEPER_ARM_MIN_SPREAD_BPS=100
KEEPER_ARM_EXIT_SPREAD_BPS=0
# Dust guard: do not open the arm below this debt (USD).
KEEPER_ARM_MIN_BORROW_USD=50
# Post NVDA collateral even when the arm is not borrowing.
KEEPER_ARM_COLLATERAL_ALWAYS=false
# Part-by-part move sizes (bps per tick): most quote first, NVDA in small slices.
KEEPER_MORPHO_ARM_SHARE_BPS=8000
KEEPER_NVDA_STEP_BPS=1000
KEEPER_BOOK_STEP_BPS=2500

# --- Surplus sweep ---
# Return quote above the inventory reserve to the book.
KEEPER_SURPLUS_SWEEP=true
KEEPER_SURPLUS_MIN_USD=25

# --- Cross-book switching ---
# Best candidate must beat the active net APR after IL by this buffer (bps).
KEEPER_SWITCH_BUFFER_BPS=250
# Candidate must hold the lead this long before the keeper switches (seconds).
KEEPER_SWITCH_CONFIRM_SECONDS=28800
# Fraction of the old book unwound on a switch (10000 = full).
KEEPER_SWITCH_UNWIND_BPS=10000
# IL multiple applied when comparing net APR (10000 = 1x).
KEEPER_IL_MULTIPLE_BPS=10000
# A switch requires both books to have live pool ids.
KEEPER_REQUIRE_BOTH_BOOKS=true

# --- Book mechanics ---
# Unwind: snap to 100% when the next slice is below these amounts.
KEEPER_UNWIND_DUST_USDG=1000000
KEEPER_UNWIND_DUST_NVDA=1000000000000000
# Extra USDG approved for a repay; the module refunds the unused quote.
KEEPER_REPAY_BUFFER_USDG=1000000
# Fraction of idle vault assets sent to the book after the arms unwind.
KEEPER_FUND_BOOK_BPS=9000

# --- Preflight (deployment gate; `npm run keeper:preflight`) ---
# Run once at startup and then on this interval (seconds).
KEEPER_PREFLIGHT=true
KEEPER_PREFLIGHT_INTERVAL_SECONDS=21600

# --- USDG Morpho lending arm (MorphoBlueLendAdapter) ---
# Market params are per deployment; nothing is prefilled.
# set at deployment; verify with npm run keeper:preflight
KEEPER_USDG_ADAPTER=
# --- Deploy the USDG lend arm (script/DeployUsdgLendArm.s.sol) ---
# set at deployment; verify with npm run keeper:preflight
USDG_LEND_COLLATERAL=
# set at deployment; verify with npm run keeper:preflight
USDG_LEND_ORACLE=
# set at deployment; verify with npm run keeper:preflight
USDG_LEND_IRM=
# set at deployment; verify with npm run keeper:preflight
USDG_LEND_LLTV=
# set at deployment; verify with npm run keeper:preflight
USDG_LEND_ABS_CAP=
USDG_LEND_REL_CAP_BPS=2000
USDG_LEND_EXECUTE=false

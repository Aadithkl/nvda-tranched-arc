# ============================================================================
# Static-fee book — deploy & agent env (Robinhood Chain; ETH gas)
# Copy to `.env` (never commit secrets). Chain records: deployments/robinhood-*.json
# ============================================================================

# --- Deployer (Foundry scripts) ---
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# --- Robinhood Chain RPC ---
# Public RPC sits behind a Cloudflare challenge; scripts add browser-like headers.
# For foundry forks use the proxy: `npm run robinhood:proxy` then ROBINHOOD_RPC_URL=http://127.0.0.1:8546
# (or point this at a provider RPC, e.g. Alchemy/Chainstack/QuickNode).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Canonical v4 + shared infra (chain 4663) ---
# Full record (PoolManager/PositionManager/Quoter/StateView/UniversalRouter): deployments/robinhood-mainnet.json
V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
ROBINHOOD_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# --- Book assets (verified on-chain; re-run `npm run robinhood:verify`) ---
# Quote: USDG (6 dec) for the USDG book, WETH (18 dec) for the WETH/NVDA book.
# Equity: NVDA stock token (ERC-20 18-dec + ERC-8056 uiMultiplier)
QUOTE_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# WETH quote for the WETH/NVDA book: 0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
NVDA_ADDRESS=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
# Chainlink stock feed (price already includes the corporate-action multiplier)
ROBINHOOD_NVDA_CHAINLINK_FEED=0x379EC4f7C378F34a1B47E4F3cbeBCbAC3E8E9F15
# Keeper session/status writer exposing marketStatus() (deployed oracle or pusher)
ROBINHOOD_SESSION_SOURCE=
# Deployed ChainlinkSessionOracle (hook price oracle)
NVDA_ORACLE=

# --- Oracle deployment (script/DeployOracle.s.sol) ---
ORACLE_OWNER=
ORACLE_WRITER=
ORACLE_MAX_STALENESS=300

# --- In-repo Aave semi-fork (testnet venue / lending adapter) ---
NVDA_PEGGED_PRICE=20000000000
USDC_PEGGED_PRICE=100000000
LENDING_BASE_BORROW_RATE=0
LENDING_RATE_SLOPE1=40000000000000000000000000
LENDING_RATE_SLOPE2=600000000000000000000000000
LENDING_OPTIMAL_UTILIZATION=800000000000000000000000000
LENDING_LTV=7500
LENDING_LIQUIDATION_THRESHOLD=8000
LENDING_LIQUIDATION_BONUS=10500
LENDING_RESERVE_FACTOR=1000

# --- Static book init config (script/DeployStaticStack.s.sol) ---
STATIC_FEE=3000
STATIC_TICK_SPACING=60
STATIC_INITIAL_TICK=
STATIC_GUARD_TICK_WIDTH=600
STATIC_BASE_TICK_WIDTH=6000
STATIC_GUARD_LIQUIDITY=50000000000000
STATIC_BASE_LIQUIDITY=500000000000
STATIC_MIN_EV_BPS=0
STATIC_RECHECK_MAX_DEV_BPS=50
STATIC_RECHECK_INTERVAL=300
STATIC_MAX_PRICE_AGE=300
STATIC_ALLOWED_SESSIONS_MASK=0
STATIC_EXPIRY=0
STATIC_INIT_BOOK=false
STATIC_VAULT=
STATIC_SIMULATOR=
# Wind-down: agent soft-halts (deployments off) this many seconds before expiry
STATIC_WINDDOWN_LEAD_SECONDS=3600

# --- Depeg latch: stock reference vs deep-pool TWAP ---
# Deepest on-chain USDG/NVDA venue (Robinhood Chain MAINNET: Uniswap v3 0.05%
# 0xd4EB21209C4D6093f80B5b84f5C45cc093EA14a3). Leave empty to disable the price
# latch (Chainlink-only fallback) or to use a different testnet pool.
DEEP_POOL=
# Minimum in-range pool liquidity (native L units) to trust the TWAP. 0.05% pool ~1.8e18.
DEEP_MIN_LIQUIDITY=500000000000000000
# Latch threshold (bps) between the Chainlink stock mid and the deep-pool TWAP.
DEPEG_THRESHOLD_BPS=200
# TWAP window (seconds) and how long the divergence must persist before latching.
DEPEG_TWAP_WINDOW=1800
DEPEG_MIN_DURATION=600
# Heartbeat cadence (seconds): market open vs closed.
DEPEG_INTERVAL_OPEN=1800
DEPEG_INTERVAL_CLOSED=3600
# Re-arm freshness gate: keeper re-enable/deploy/rearm requires a check this recent.
# 0 disables the gate.
DEPEG_MAX_CHECK_AGE=5400

# --- Dual-book stack (script/DeployDualBookStack.s.sol): low-fee book A + high-fee B ---
STATIC_FEE_A=3000
STATIC_TICK_SPACING_A=60
STATIC_FEE_B=10000
STATIC_TICK_SPACING_B=200
# Per-book guard params for B (A reuses the STATIC_* above); same keys, STATIC_B_ prefix
STATIC_B_GUARD_TICK_WIDTH=600
STATIC_B_BASE_TICK_WIDTH=6000
STATIC_B_GUARD_LIQUIDITY=50000000000000
STATIC_B_BASE_LIQUIDITY=500000000000
STATIC_B_MIN_EV_BPS=0
STATIC_B_RECHECK_MAX_DEV_BPS=50
STATIC_B_RECHECK_INTERVAL=300
STATIC_B_MAX_PRICE_AGE=300
STATIC_B_ALLOWED_SESSIONS_MASK=0
# Init both books armed (needs inventory: init deploys bands strictly). Approve the
# deploy script for quote+equity first. A funds via the vault, B stages direct.
STATIC_INIT_BOOKS=false
STATIC_FUND_QUOTE=
STATIC_FUND_EQUITY=
STATIC_FUND_B_QUOTE=
STATIC_FUND_B_EQUITY=

# --- Strategy module (Morpho on Robinhood) ---
# Primary NVDA/USDG market (lltv 62.5%) verified on-chain; deepest market (0x8b16…9c3e) is ~100%
# utilized — do not park there. RH Morpho has no id() view; ids = keccak256(abi.encode(params)).
ROBINHOOD_MORPHO_BLUE=0x9D53d5E3bd5E8d4Cbfa6DB1ca238AEA02E651010
MORPHO_MARKET_ORACLE=0x37CF511fA79B8446f1C23D6a81Df117F28240bE0
MORPHO_MARKET_IRM=0x2BD3d5965B26B51814AC95127B2b80dD6CcC0fa1
MORPHO_MARKET_LLTV=625000000000000000
STATIC_ALLOCATOR_ADDRESS=
STATIC_SENTINEL_ADDRESS=
STATIC_STRATEGY_TIMELOCK_SECONDS=86400

# --- Agent (operator key = allocator/keeper; see agent/README.md) ---
AGENT_OPERATOR_PRIVATE_KEY=
AGENT_OPERATOR_ADDRESS=

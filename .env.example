# ── Before running (deploy-time checklist) ────────────────────────────────────
# Required:     DEPLOYER_PRIVATE_KEY, USDC_ADDRESS, NVDA_ADDRESS (18-dec NVDA token on Arc)
# Price:        NVDA_ORACLE (x402 NVDAPriceOracle), ORACLE_ADDRESS (keeper writer),
#               NVDA_PEGGED_PRICE (lending peg, USD 8d, e.g. 20000000000)
# Pool seed:    NVDA_POOL_FEE / NVDA_POOL_TICK_SPACING / NVDA_POOL_PRICE (tick auto-derived)
# Then run:     npm run lending:seed  &&  npm run seed:nvda -- --execute
# ──────────────────────────────────────────────────────────────────────────────

# Arc Testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
DEPLOYER_MNEMONIC=

# x402 stock price keeper
# Circle-only rail: our own Gateway seller on Arc testnet (scripts/x402-seller.mjs, port 4021)
X402_STOCK_URL=http://127.0.0.1:4021/api/nvda
X402_PAYER_PRIVATE_KEY=
# Circle Gateway nanopayments required; set 0 only for legacy raw x402
X402_USE_GATEWAY=1
X402_PREFERRED_NETWORK=eip155:8453
X402_MAX_PAYMENT_USDC=0.01
X402_WRITER=
ORACLE_ADDRESS=

# Circle Gateway (buyer client auto-selects the testnet API for arcTestnet)
GATEWAY_WALLET=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
GATEWAY_MINTER=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B
GATEWAY_DOMAIN=26
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com

# x402 seller (must differ from payer; self_transfer is rejected by Gateway)
X402_SELLER_ADDRESS=
X402_SELLER_PRIVATE_KEY=
X402_SELLER_PORT=4021
X402_SELLER_PRICE=$0.001

# The Graph
# Deploy key: thegraph.com/studio -> create subgraph -> Settings -> Deploy Key
# Then: graph auth $GRAPH_DEPLOY_KEY && cd subgraph && npm run deploy:studio
GRAPH_DEPLOY_KEY=
# Query endpoint (keyless Studio URL or gateway URL) + optional API key
GRAPH_URL=
GRAPH_API_KEY=
# Optional: Substreams (StreamingFast) token. Arc has no public Substreams endpoint,
# so this is only useful for chains with a Firehose/Substreams provider.
SUBSTREAMS_API_TOKEN=

# Agent market model (Graph-only pool registry + math)
AGENT_MARKET_POOLS=agent/pools.json
AGENT_MARKET_WINDOW_HOURS=336
AGENT_MARKET_TRIGGER_HOURS=3
AGENT_MARKET_BANDS_BPS=25,50,100,200,500
AGENT_MARKET_HORIZON_HOURS=1
AGENT_MIN_EDGE_BPS=0.2
AGENT_MIN_P_IN_RANGE=0.6
AGENT_MAX_P_IL_EXCEEDS_FEES=0.35
AGENT_MARKET_CACHE=agent/.cache/market.json
AGENT_MARKET_CACHE_TTL=900

# Circle (Console + CLI + Agent Marketplace)
# Client key for modular wallets / Paymaster: Console -> Keys -> Create Key -> Client Key
# Also set Console -> Wallets -> Modular Wallets -> Passkey domain to your app domain (frontend phase).
CIRCLE_CLIENT_KEY=
# Accept the Circle CLI terms non-interactively (agents.circle.com/terms-of-use)
CIRCLE_ACCEPT_TERMS=1
# Agent wallet (created by `circle wallet login <email>`; list with
# `circle wallet list --type agent --chain BASE -o json`)
AGENT_CIRCLE_WALLET=
# Agent Marketplace reasoning purchase
# Default (working): BlockRun.AI chat completions, payable via Circle Gateway on Polygon
AGENT_AI_SERVICE_URL=https://nano.blockrun.ai/api/v1/chat/completions
AGENT_AI_MODEL=gpt-4o-mini
AGENT_AI_CHAIN=MATIC
AGENT_AI_CHAIN_NETWORK=eip155:137
AGENT_AI_MAX_PAYMENT_USDC=0.01
# Alternatives found in the Circle Agent Marketplace:
#   https://api.aisa.one/v2/chat/completions (90 models, $0.003 min, Gateway)
#     NOTE: AIsa rejects the Circle CLI payment (maxTimeoutSeconds mismatch); use an SDK payer.
#   https://api.venice.ai/api/v1/chat/completions (vanilla x402, $10/call listing)

# Oracle deployment tuning
ORACLE_OWNER=
X402_MAX_STALENESS=300

# Tranche stack (JIT hook v2 + vaults + accountant)
TRANCHE_HOOK=
TRANCHE_SHARE=
TRANCHE_ACCOUNTANT=
TRANCHE_SENIOR=
TRANCHE_JUNIOR=
TRANCHE_POOL_ID=
# v3 pipe (TranchePipeModule); vaults use it for dual-token exits
PIPE_ADDRESS=
# Maturity timestamp (unix seconds) shared by the hook + both vaults; blank/0 = no expiry
EXPIRY_TIMESTAMP=
# v4 stack (test tokens; legacy MOCK_USDC/MOCK_NVDA/MOCK_WETH9 still read as fallback)
TEST_USDC=
TEST_NVDA=
POSM_UNSUBSCRIBE_GAS_LIMIT=300000
NATIVE_CURRENCY_LABEL=WETH
V4_POOL_MANAGER=
DEMO_ROUTER=
SMOKE_HOOK=
DEMO_SELLER=
TEST_WETH9=
POSITION_DESCRIPTOR=
POSITION_MANAGER=
STATE_VIEW=
V4_QUOTER=
RESERVES_LENS=

# USDC/NVDA v3 stack (dual-token exits + agent rebalancing; addresses inserted at deploy)
NVDA_ADDRESS=
NVDA_ORACLE=
V3_TICK_SPACING=60
V3_INITIAL_TICK=
V3_HARD_CAP_BPS=7500
# Optional external rebalance venue (plain pool, no hook) + router for agent swaps
REBALANCE_ROUTER=
REBALANCE_POOL_FEE=
REBALANCE_TICK_SPACING=

# USDC/NVDA pool seed (uses NVDA_ADDRESS from the v3 stack section above)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
NVDA_POOL_FEE=3000
NVDA_POOL_TICK_SPACING=60
NVDA_POOL_PRICE=200
NVDA_POOL_TICK=
NVDA_POOL_TICK_LOWER=
NVDA_POOL_TICK_UPPER=
NVDA_POOL_LIQUIDITY=1000000000
NVDA_POOL_MAX_USDC=5050000
NVDA_POOL_MAX_NVDA=50000000000000000

# Lending (Aave V2 semi-fork) — export overrides (deployed defaults live in scripts/export-frontend-pack.mjs)
LENDING_PROVIDER=
LENDING_POOL=
LENDING_CONFIGURATOR=
LENDING_ORACLE=
A_USDC=
D_USDC=
A_NVDA=
D_NVDA=
NVDA_PEGGED_PRICE=20000000000

# TrancheJITHook live demo (see docs/DEPLOYMENTS.md)
HOOK_DEMO_HOOK=
HOOK_DEMO_ORACLE=
HOOK_DEMO_CONTROLLER=
HOOK_DEMO_AGENT=
AGENT_OPERATOR_ADDRESS=
# AGENT_OPERATOR_PRIVATE_KEY stays in the local .env only (generate: npm run
# agent:keygen); never commit or share it.

# Offchain agent policy daemon (agent/README.md)
AGENT_HOOK=
AGENT_MODULE=
AGENT_ORACLE=
AGENT_ADDRESS=
AGENT_KEEPER=
AGENT_CADENCE_SECONDS=600
PARAMS_TTL_SECONDS=3600
AGENT_REASONING_URL=
# LLM strategy manager: paid verdict refreshed every 6h by agent/refresh.mjs (heartbeat workflow).
# Audit overrides stay usable for 2x the interval; rebalance calls must be one interval old at most.
AGENT_LLM_REFRESH_SECONDS=21600
AGENT_REASONING_MAX_AGE_SECONDS=43200
AGENT_REBALANCE_MAX_AGE_SECONDS=21600
AGENT_POLICY_CACHE=agent/.cache/policy.json
# Rebalancing is LLM-owned; deterministic code only validates the hard rails (equity hard cap,
# size limits, funding, oracle). Max equity is capped onchain (TranchePipeModule.hardMaxEquityBps).
AGENT_REBALANCE_ENABLED=1
AGENT_REBALANCE_MIN_USD=1
AGENT_REBALANCE_MAX_USD=500
AGENT_REBALANCE_SLIPPAGE_BPS=50
AGENT_REBALANCE_DEADLINE_SECONDS=300
# Economic audit gate (agent/model.mjs `economicAudit`; env defaults, LLM may override within
# hard clamps; see agent/README.md)
AGENT_AUDIT_MIN_NET_EDGE_BPS=0.2
AGENT_AUDIT_MIN_BUFFER_BPS=500
AGENT_AUDIT_MAX_DEPLOY_OF_JUNIOR_BPS=5000
AGENT_AUDIT_MAX_VAR95_BPS=500
AGENT_AUDIT_MAX_PIL_EXCEEDS_FEES=0.35

# Optional keyed RPC fallback if the public endpoint rate-limits
ARC_RPC_URL_FALLBACK=

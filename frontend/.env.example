# VITE_* variables are read from the repo-root .env (vite.config.ts sets envDir: "..").
# Circle modular wallets client key (Console -> Keys -> Client Key)
# Hosted (Pages): key's allowed domain + passkey domain must be aadithkl.github.io
# Local dev: use a key/domain pair for localhost (passkeys are domain-bound)
VITE_CLIENT_KEY=
# Modular wallets backend URL (same for every app)
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
# Optional RPC override
VITE_ARC_RPC=https://rpc.testnet.arc.network
# The Graph gateway API key (reads the NVDAc market pools for the onchain price card)
VITE_GRAPH_API_KEY=
# Local agent HTTP bridge for the "Run agent check" button (`npm run agent:serve`)
VITE_AGENT_URL=http://127.0.0.1:8787
# Optional gateway override
VITE_GRAPH_GATEWAY=https://gateway.thegraph.com/api
